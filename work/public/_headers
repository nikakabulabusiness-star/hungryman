# Cache content-hashed assets immutably (same rule vinext generates when this file is absent).
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Shared call/dock assets are always referenced with a ?v= release number
# (app/layout.tsx, components/chat-notifications.tsx, lib/browser-call.ts).
# The two stylesheets block first paint on every full page navigation, so avoid a
# revalidation round trip for each page switch. Bump the ?v= value when editing them.
/work/call-client.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/work/chat-dock.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/work/call-client.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/work/chat-dock.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/work/desktop-notices.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
